GEMINI_API_KEY=replace-with-your-google-ai-studio-key
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
CLOUDFLARE_API_TOKEN=replace-with-your-cloudflare-workers-ai-token
CLOUDFLARE_ACCOUNT_ID=replace-with-your-cloudflare-account-id
PORT=3000

# R2 S3 credentials (separate from the Workers AI token)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public bucket custom domain, or r2.dev URL for testing; no trailing path
R2_PUBLIC_BASE_URL=

# Neon PostgreSQL connection string (server only)
DATABASE_URL=
CONTENT_FEED_API_URL=https://kidsverse-apinew.vercel.app/api/v1/admin/content/feed
# Optional when the content API requires bearer authentication.
CONTENT_FEED_API_TOKEN=
